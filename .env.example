# Пример конфигурации для Cronodamp
# Скопируйте этот файл в .env и настройте переменные

# Путь к папке с базами данных Kronos
KRONOS_DB_PATH=/home/usersamba/smb/

# Строка подключения к ClickHouse (хост:порт)
CLICKHOUSE_DSN=localhost:9000

# База данных ClickHouse
CLICKHOUSE_DB=default

# Пользователь ClickHouse
CLICKHOUSE_USER=default

# Пароль ClickHouse
CLICKHOUSE_PASSWORD=default

# Режим отладки (true/false)
DEBUG=false